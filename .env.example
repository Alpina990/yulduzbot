# Production uchun ushbu fayldan nusxa oling va nomini ".env" deb saqlang.
# (Serverda alohida .env.yulduz yoki .env.star qilinmaydi, faqat bitta .env bo'ladi)

# Brend nomi (App.tsx avtomatik ravishda /{brand_name}_icon.png logotipini qidiradi)
# Masalan: YulduzPay -> /yulduzpay_icon.png
VITE_BRAND_NAME="YulduzPay"

# Telegram botning manzil havolasi
VITE_BOT_URL="https://telegram.dog/YulduzPayBot?start=auto"

# StarPay /gift sahifasidagi barcha tugmalar uchun alohida deep link.
# Berilmasa VITE_BOT_URL ishlatiladi.
#VITE_GIFT_BOT_URL="https://telegram.dog/StarPayBot?start=gifts"

# Facebook (Meta) Pixel ID — har bir brend uchun alohida
VITE_FB_PIXEL_ID=""

#StarPay uchun:
#VITE_BRAND_NAME="StarPay"
#VITE_BOT_URL="https://telegram.dog/StarPayBot?start=auto"
#VITE_GIFT_BOT_URL="https://telegram.dog/StarPayBot?start=gifts"
#VITE_FB_PIXEL_ID="1484190689679054"
