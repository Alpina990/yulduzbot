# Production uchun ushbu fayldan nusxa oling va nomini ".env" deb saqlang.
# (Serverda alohida .env.yulduz yoki .env.star qilinmaydi, faqat bitta .env bo'ladi)

# Brend nomi (App.tsx avtomatik ravishda /{brand_name}_icon.png logotipini qidiradi)
# Masalan: YulduzPay -> /yulduzpay_icon.png
VITE_BRAND_NAME="YulduzPay"

# Telegram botning manzil havolasi
VITE_BOT_URL="https://t.me/YulduzPayBot?start=auto"

#StarPay uchun:
#VITE_BRAND_NAME="StarPay"
#VITE_BOT_URL="https://t.me/StarPayBot?start=auto"
